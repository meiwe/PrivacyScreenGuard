<Application x:Class="PrivacyScreenGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 自定义画刷字典（索引 0，ThemeManager 运行时在此位置替换 Light/Dark） -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml"/>
                <!-- 排版 token 与卡片样式（与主题无关，常驻） -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Typography.xaml"/>
                <!-- WPF-UI：Fluent 控件样式 + 官方明暗主题（ApplicationThemeManager 切换） -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- 隐式按钮覆盖（ghost 极简风）：必须位于 WPF-UI 字典之后才能生效 -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Luxury.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
