<Application x:Class="PrivacyScreenGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 画刷字典（索引 0，ThemeManager 运行时在此位置替换 Light/Dark） -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml"/>
                <!-- 控件样式常驻：DynamicResource 引用画刷，随主题自动刷新 -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
