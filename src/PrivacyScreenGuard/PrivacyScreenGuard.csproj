<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标使用 WinForms 的 NotifyIcon，遮罩屏幕枚举使用 Screen 类 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标：exe / 桌面快捷方式 / 任务栏统一使用 -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RootNamespace>PrivacyScreenGuard</RootNamespace>
    <!-- 单文件发布时原生库（OpenCvSharp 的 dll）一并打包 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标资源打包进程序集：窗口标题栏图标与托盘底图运行时经 pack URI 加载 -->
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon_32.png" />
    <Resource Include="Assets\icon_256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
    <!-- Fluent 控件样式与明暗主题服务（Windows 11 观感） -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

</Project>
