<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        排版 token：8pt 网格间距 + Fluent 类型标尺字号 + 卡片样式。
        画刷 token 在 Light/Dark.xaml；本字典与主题无关，启动后常驻。
        卡片视觉遵循奢华极简规范：无粗边框、大圆角、极低透明度软阴影、慷慨内边距。
    -->

    <!-- 间距 token（8pt 网格：4 / 8 / 12 / 16 / 24） -->
    <Thickness x:Key="Space.XS">4</Thickness>
    <Thickness x:Key="Space.S">8</Thickness>
    <Thickness x:Key="Space.M">12</Thickness>
    <Thickness x:Key="Space.L">16</Thickness>
    <Thickness x:Key="Space.XL">24</Thickness>

    <!-- 字号 token（类型标尺：Caption 12 / Body 14 / Title 20） -->
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>

    <!-- 卡片容器：14px 大圆角 + 极细边框（8%）+ 软阴影（模拟浮起）+ 内边距 20 -->
    <Style x:Key="Card" TargetType="GroupBox">
        <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bg.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <!-- 大扩散、低透明度的柔和阴影：0 4px 24px rgba(0,0,0,0.05) -->
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                              Opacity="0.05" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- 分区标题：Body 14 SemiBold，与内容间距 10 -->
                            <TextBlock Text="{TemplateBinding Header}"
                                       FontSize="{StaticResource FontSize.Body}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <ContentPresenter/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（实心填充）：黑底白字（暗色反转），极简无阴影 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Solid.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Solid.Foreground}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"/>
                        <!-- 悬停叠加层：只动透明度（主题安全），0.3s 缓动 -->
                        <Border x:Name="hover" Background="{DynamicResource Bg.Hover}" CornerRadius="8" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 极简输入框：无系统边框，浅灰填充 + 聚焦时底部强调色细线淡入 -->
    <Style x:Key="MinimalTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fg.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <!-- 聚焦底线：香槟金 1.5px，淡入不闪烁 -->
                        <Rectangle x:Name="focusLine" Height="1.5" Margin="10,0"
                                   Fill="{DynamicResource Accent}" Opacity="0"
                                   VerticalAlignment="Bottom"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="focusLine" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="focusLine" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 极简滑块：4px 细轨道 + 白色圆形滑块头（细阴影），悬停微放大 -->
    <Style x:Key="MinimalSlider" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- 轨道：4px 圆角 -->
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Bg.Input}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{x:Null}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <!-- 已选轨道：主文本色（黑/白反转），克制不刺眼 -->
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Fg.Primary}"
                                                        HorizontalAlignment="Left"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{x:Null}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="thumbScale" ScaleX="1" ScaleY="1"/>
                                                </Grid.RenderTransform>
                                                <!-- 滑块头：纯白圆形 + 细微阴影，绝不使用方角 -->
                                                <Ellipse Fill="{DynamicResource Bg.Card}" Stroke="{DynamicResource Bg.Border}" StrokeThickness="0.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                                          Opacity="0.25" Color="#000000"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <!-- 悬停微微放大 1.05，0.3s 缓出 -->
                                                                <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.05" Duration="0:0:0.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.05" Duration="0:0:0.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX"
                                                                                 To="1" Duration="0:0:0.3"/>
                                                                <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY"
                                                                                 To="1" Duration="0:0:0.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
