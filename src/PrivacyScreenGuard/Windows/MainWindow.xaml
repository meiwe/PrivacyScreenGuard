<Window x:Class="PrivacyScreenGuard.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摄像头隐私屏"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Fg.Primary}"
        Width="860" Height="820"
        MinWidth="760" MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 标题区 -->
            <RowDefinition Height="*"/>    <!-- 主体内容 -->
            <RowDefinition Height="Auto"/> <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- 标题区：墨色徽标 + 名称 + Overline 英文小字；右侧主题切换 -->
        <Grid Grid.Row="0" Margin="16,20,16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{DynamicResource Solid.Fill}">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,3 L5,6 L5,11 C5,15.5 8,19.5 12,21 C16,19.5 19,15.5 19,11 L19,6 L12,3 Z"
                                  Stroke="{DynamicResource Solid.Foreground}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                            <Ellipse Canvas.Left="9.6" Canvas.Top="8.6" Width="4.8" Height="4.8"
                                     Fill="{DynamicResource Solid.Foreground}"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="摄像头隐私屏" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="CAMERA PRIVACY GUARD" Style="{StaticResource Overline}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <!-- 明暗主题切换（全局控件，固定在标题区右上） -->
            <Button x:Name="BtnTheme" Style="{StaticResource CircleButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" ToolTip="切换明亮 / 深色主题">
                <TextBlock x:Name="TxtThemeIcon" Text="☀" FontSize="14"/>
            </Button>
        </Grid>

        <!-- 主体：各分区（内容超高时可滚动） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,20,16,0">
            <StackPanel Margin="0,0,0,24">

                <!-- ============ 1. 守护状态（Hero：全窗最重点） ============ -->
                <GroupBox Header="守护状态" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- 状态点：柔和外发光 + 呼吸动画（3.2s 循环），颜色随状态由代码后置同步 -->
                                <Ellipse x:Name="StatusLight" Width="12" Height="12" Fill="{DynamicResource StatusOK}"
                                         VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect x:Name="StatusGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.8"
                                                          Color="#34A853"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="StatusGlow" Storyboard.TargetProperty="Opacity"
                                                                     From="0.9" To="0.35" Duration="0:0:1.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="StatusGlow" Storyboard.TargetProperty="BlurRadius"
                                                                     From="6" To="12" Duration="0:0:1.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" Text="正在初始化…" FontSize="26" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CameraInUseText" Text="摄像头使用中" FontSize="12"
                                       Foreground="{DynamicResource Fg.Tertiary}" Margin="26,12,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <Button x:Name="BtnPauseResume" Content="暂停守护" Grid.Column="1"
                                MinWidth="96" VerticalAlignment="Top"/>
                    </Grid>
                </GroupBox>

                <!-- ============ 2. 检测参数 ============ -->
                <GroupBox Header="检测参数" Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- 行：标签左 · 滑块中 · 数值右，行间发丝分隔 -->
                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="识别阈值" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <Slider x:Name="SldThreshold" Grid.Column="1" Minimum="0.3" Maximum="0.9" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="24,0,20,0"/>
                            <TextBlock x:Name="TxtThresholdValue" Grid.Column="2" Text="0.55" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="触发延迟" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <Slider x:Name="SldTriggerDelay" Grid.Column="1" Minimum="300" Maximum="800" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="24,0,20,0"/>
                            <TextBlock x:Name="TxtTriggerDelayValue" Grid.Column="2" Text="500" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="恢复延迟" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <Slider x:Name="SldRecoverDelay" Grid.Column="1" Minimum="500" Maximum="1000" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="24,0,20,0"/>
                            <TextBlock x:Name="TxtRecoverDelayValue" Grid.Column="2" Text="800" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="检测帧率" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <ComboBox x:Name="CmbFps" Grid.Column="1" Width="150" MinHeight="32" FontSize="13"
                                      HorizontalAlignment="Left" VerticalAlignment="Center">
                                <ComboBoxItem Content="5 帧/秒"/>
                                <ComboBoxItem Content="6 帧/秒"/>
                                <ComboBoxItem Content="8 帧/秒"/>
                                <ComboBoxItem Content="10 帧/秒"/>
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="无人策略" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <ComboBox x:Name="CmbNoFacePolicy" Grid.Column="1" Width="150" MinHeight="32" FontSize="13"
                                      HorizontalAlignment="Left" VerticalAlignment="Center">
                                <ComboBoxItem Content="保持正常"/>
                                <ComboBoxItem Content="触发锁定"/>
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="多人在场" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="CmbMultiPerson" Width="170" MinHeight="32" FontSize="13"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="主人在场即放行"/>
                                    <ComboBoxItem Content="有陌生人即遮罩"/>
                                </ComboBox>
                                <TextBlock Text="给别人看屏幕时选放行" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="16,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 3. 设备选择 ============ -->
                <GroupBox Header="设备选择" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="摄像头" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="CmbCamera" Width="300" MinHeight="32" FontSize="13"
                                          DisplayMemberPath="Display" VerticalAlignment="Center"/>
                                <Button x:Name="BtnRefreshCameras" Content="刷新" MinWidth="64" Margin="16,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="守护显示器" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RbAllMonitors" Content="所有显示器" GroupName="MonitorMode"
                                             IsChecked="True" Style="{StaticResource PillRadio}"/>
                                <RadioButton x:Name="RbPrimaryMonitor" Content="仅主屏" GroupName="MonitorMode"
                                             Style="{StaticResource PillRadio}" Margin="8,0,0,0"/>
                                <RadioButton x:Name="RbSelectedMonitors" Content="自选" GroupName="MonitorMode"
                                             Style="{StaticResource PillRadio}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="LstMonitors" Height="72" SelectionMode="Multiple" IsEnabled="False"
                                 DisplayMemberPath="Display" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 4. 快捷与启动 ============ -->
                <GroupBox Header="快捷与启动" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="暂停 / 恢复热键" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="CmbHotkeyMods" Width="120" MinHeight="32" FontSize="13"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="Ctrl + Alt" IsSelected="True"/>
                                    <ComboBoxItem Content="Ctrl + Shift"/>
                                    <ComboBoxItem Content="Alt + Shift"/>
                                </ComboBox>
                                <TextBox x:Name="TxtHotkeyKey" Width="48" MaxLength="3" Text="P" MinHeight="32"
                                         TextAlignment="Center" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" Margin="12,0,0,0"
                                         Style="{StaticResource MinimalTextBox}"
                                         ToolTip="主键支持 A-Z、0-9 或 F1-F12"/>
                                <TextBlock Text="主键支持 A-Z、0-9 或 F1-F12" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="16,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="52">
                            <TextBlock Text="开机自动启动" VerticalAlignment="Center" FontSize="13"/>
                            <ToggleButton x:Name="ChkAutostart" Style="{StaticResource LuxSwitch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid Height="52">
                            <TextBlock Text="启用摄像头守护" VerticalAlignment="Center" FontSize="13"/>
                            <ToggleButton x:Name="ChkCameraEnabled" Style="{StaticResource LuxSwitch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 5. 遮罩外观 ============ -->
                <GroupBox Header="遮罩外观" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊强度" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                            <Slider x:Name="SldBlur" Grid.Column="1" Minimum="0" Maximum="100" Value="50"
                                    Style="{StaticResource MinimalSlider}" VerticalAlignment="Center" Margin="24,0,20,0"/>
                            <TextBlock x:Name="TxtBlurValue" Grid.Column="2" Text="50" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid MinHeight="56" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="识别侧脸样本" FontSize="13"/>
                                <TextBlock Text="遮罩激活时截屏高斯模糊；0 = 纯黑遮罩" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ChkStrictPose" Style="{StaticResource LuxSwitch}" Grid.Column="1"
                                          VerticalAlignment="Center" IsChecked="True"
                                          ToolTip="开启后：侧脸/贴边脸也参与身份比对（配合注册的左/右转头模板，能认出侧脸的主人，同时拦截侧脸的陌生人）；&#x0a;关闭时：侧脸不参与判定（不触发遮罩，但侧身的陌生人也会被放过）"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 6. 健康提醒 ============ -->
                <GroupBox Header="健康提醒" Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- 行：标签（标题+说明）· 滑块 · 数值 · 开关，行间发丝分隔 -->
                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="久坐提醒" FontSize="13" Foreground="{DynamicResource Fg.Primary}"/>
                                <TextBlock Text="连续在场分钟数" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="SldSedentary" Grid.Column="1" Minimum="15" Maximum="120" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                                    VerticalAlignment="Center" Margin="24,0,20,0"
                                    ToolTip="连续在场超过设定分钟数后提醒起身活动"/>
                            <TextBlock x:Name="TxtSedentary" Grid.Column="2" Text="45" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ChkSedentary" Grid.Column="3" Style="{StaticResource LuxSwitch}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="用眼距离" FontSize="13" Foreground="{DynamicResource Fg.Primary}"/>
                                <TextBlock Text="脸宽占比阈值" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="SldNear" Grid.Column="1" Minimum="0.25" Maximum="0.5" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.02"
                                    VerticalAlignment="Center" Margin="24,0,20,0"
                                    ToolTip="人脸框宽占画面宽度的比例超过该值视为距离过近；越小越灵敏"/>
                            <TextBlock x:Name="TxtNear" Grid.Column="2" Text="0.35" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ChkNear" Grid.Column="3" Style="{StaticResource LuxSwitch}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="低头坐姿" FontSize="13" Foreground="{DynamicResource Fg.Primary}"/>
                                <TextBlock Text="低头比例阈值" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="SldSlouch" Grid.Column="1" Minimum="0.5" Maximum="0.8" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.02"
                                    VerticalAlignment="Center" Margin="24,0,20,0"
                                    ToolTip="低头程度比例超过该值开始计时，持续过久提醒挺直腰背"/>
                            <TextBlock x:Name="TxtSlouch" Grid.Column="2" Text="0.62" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ChkSlouch" Grid.Column="3" Style="{StaticResource LuxSwitch}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="喝水提醒" FontSize="13" Foreground="{DynamicResource Fg.Primary}"/>
                                <TextBlock Text="间隔分钟数" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="SldWater" Grid.Column="1" Minimum="15" Maximum="180" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="15" IsSnapToTickEnabled="True" SmallChange="15" LargeChange="30"
                                    VerticalAlignment="Center" Margin="24,0,20,0"
                                    ToolTip="每隔设定分钟数提醒补充水分"/>
                            <TextBlock x:Name="TxtWater" Grid.Column="2" Text="60" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ChkWater" Grid.Column="3" Style="{StaticResource LuxSwitch}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Bg.Border}"/>

                        <Grid MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="放松提醒" FontSize="13" Foreground="{DynamicResource Fg.Primary}"/>
                                <TextBlock Text="间隔分钟数" FontSize="11"
                                           Foreground="{DynamicResource Fg.Tertiary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider x:Name="SldBreak" Grid.Column="1" Minimum="10" Maximum="120" Style="{StaticResource MinimalSlider}"
                                    TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="20"
                                    VerticalAlignment="Center" Margin="24,0,20,0"
                                    ToolTip="每隔设定分钟数提醒远眺放松眼睛"/>
                            <TextBlock x:Name="TxtBreak" Grid.Column="2" Text="30" FontFamily="Consolas"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ChkBreak" Grid.Column="3" Style="{StaticResource LuxSwitch}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>

                        <!-- 卡片脚注：健康能力的数据边界说明 -->
                        <TextBlock Text="健康分析仅使用人脸几何数据，本机处理，不上传不保存；距离与坐姿为粗略估算，仅供参考"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Fg.Tertiary}" Margin="0,12,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- ============ 7. 隐私与数据（危险区） ============ -->
                <GroupBox Header="隐私与数据" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="所有画面仅本地处理，不上传、不录制、不保存。主人特征以 DPAPI 加密存储，仅保存在本机当前用户目录。"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Tertiary}"
                                   MaxWidth="560" HorizontalAlignment="Left"/>
                        <Button x:Name="BtnClearTemplate" Content="清除主人人脸数据" MinWidth="140"
                                HorizontalAlignment="Left" Margin="0,20,0,0"
                                BorderBrush="#66C0453E" Foreground="#E5C0453E"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态栏：磨砂玻璃（半透明卡底 + Mica），版本 + 最新提示消息 -->
        <Border Grid.Row="2" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Bg.Border}" BorderThickness="0,0.5,0,0"
                Padding="32,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtVersion" Text="PrivacyScreenGuard" FontSize="11" FontFamily="Consolas"
                           Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusMessage" Grid.Column="1" Margin="24,0,0,0" Text="就绪"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
